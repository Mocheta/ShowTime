@using Microsoft.AspNetCore.Components.Authorization

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand showtime-brand" href="">ShowTime</a>
    </div>
</div>
<input type="checkbox" title="Navigation menu" class="navbar-toggler" />
<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column d-flex h-100">
        <div class="flex-grow-1">
            <AuthorizeView>
                <Authorized>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                            <span class="bi bi-house-door-fill" aria-hidden="true"></span> Home
                        </NavLink>
                    </div>

                    
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="artists">
                            <span class="bi bi-people-fill align-middle me-2" aria-hidden="true"></span> Artists
                        </NavLink>
                    </div>

                    
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="festivals">
                            <span class="bi bi-music-note-list align-middle me-2" aria-hidden="true"></span> Festivals
                        </NavLink>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="access-denied" Match="NavLinkMatch.All">
                            <span class="bi bi-house-door-fill" aria-hidden="true"></span> Home
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="access-denied">
                            <span class="bi bi-people-fill align-middle me-2" aria-hidden="true"></span> Artists
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="access-denied">
                            <span class="bi bi-music-note-list align-middle me-2" aria-hidden="true"></span> Festivals
                        </NavLink>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <!-- Login/Logout button at bottom -->
        <div class="nav-bottom px-3 pb-3">
            <AuthorizeView>
                <Authorized>
                    <NavLink class="btn btn-logout w-100" href="logout">
                        <span class="bi bi-box-arrow-right me-2" aria-hidden="true"></span> Logout
                    </NavLink>
                </Authorized>
                <NotAuthorized>
                    <NavLink class="btn btn-login w-100" href="login">
                        <span class="bi bi-box-arrow-in-right me-2" aria-hidden="true"></span> Login
                    </NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </nav>
</div>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap');

    .showtime-brand {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        margin: 0;
        padding: 15px 0;
        font-family: 'Orbitron', monospace;
        font-weight: 900;
        font-size: 1.8rem;
        background: linear-gradient(45deg, #ff6b6b, #4ecdc4, #45b7d1, #96ceb4);
        background-size: 300% 300%;
        text-shadow: 0 0 20px rgba(255, 107, 107, 0.3);
        animation: gradientShift 3s ease-in-out infinite;
        text-decoration: none !important;
        letter-spacing: 2px;
        position: relative;
    }

    .showtime-brand::before {

        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(45deg, #ff6b6b, #4ecdc4, #45b7d1, #96ceb4);
        background-size: 300% 300%;
        opacity: 0;
        border-radius: 8px;
        filter: blur(8px);
        z-index: -1;
        animation: gradientShift 3s ease-in-out infinite;
        transition: opacity 0.3s ease;
    }

    .showtime-brand:hover::before {
        opacity: 0.2;
    }


    @@keyframes gradientShift {
        0%

    {
        background-position: 0% 50%;
    }

    50% {
        background-position: 100% 50%;
    }

    100% {
        background-position: 0% 50%;
    }

    }

    .top-row {
        height: 60px; /* or whatever height you want */
        padding: 0 !important;
    }
    .nav-section-title {
        color: #d7d7d7;
        font-size: 0.9rem;
        padding: 0.5rem 0;
        margin-left: 0.5rem;
        font-weight: 500;
    }

    .nav-link {
        font-family: 'Orbitron', monospace;
        font-weight: 400;
        letter-spacing: 1px;
    }

    .nav-link .bi {
        font-size: 1.2em;
        vertical-align: middle;
        line-height: 0;
        margin-top: -1px;
    }

    .nav-scrollable {
        height: 100vh;
    }

        .nav-scrollable nav {
            height: 100%;
        }

    .btn-login, .btn-logout {
        background: linear-gradient(135deg, #28a745, #20c997);
        border: none;
        color: white;
        padding: 12px 20px;
        border-radius: 8px;
        font-weight: 500;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        box-shadow: 0 2px 4px rgba(40, 167, 69, 0.3);
        font-family: 'Orbitron', monospace;
        font-weight: 500;
        letter-spacing: 1px;
    }

        .btn-login:hover, .btn-logout:hover {
            background: linear-gradient(135deg, #218838, #1eb396);
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(40, 167, 69, 0.4);
            color: white;
            text-decoration: none;
        }

        .btn-login:active, .btn-logout:active {
            transform: translateY(0);
            box-shadow: 0 2px 4px rgba(40, 167, 69, 0.3);
        }

    .nav-bottom {
        margin-top: auto;
    }

    .container-fluid {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 !important;
        width: 100%;
    }
</style>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">