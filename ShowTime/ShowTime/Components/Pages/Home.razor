@page "/"
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<div class="home-container">
    <div class="hero-overlay">
        <div class="hero-content">
            <h1 class="hero-title">ShowTime</h1>
            <p class="hero-subtitle">Manage your <span class="highlight-artists">artists</span> and <span class="highlight-festivals">festivals</span> with <span class="highlight-style">style</span></p>

            <div class="button-container">
                <button class="dive-button" @onclick="NavigateToSignin">
                    <i class="bi bi-play-circle-fill me-2"></i>
                    Dive In!
                </button>

                <div class="login-section">
                    <p class="login-text">Already have an account?</p>
                    <button class="login-button" @onclick="NavigateToLogin">
                        <i class="bi bi-box-arrow-in-right me-2"></i>
                        Login
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700;800&display=swap');

    body, html {
        margin: 0;
        padding: 0;
        height: 100%;
        overflow-x: hidden;
    }

    .home-container {
        height: 100vh;
        width: 100vw;
        background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.7)), url('https://images.unsplash.com/photo-1540039155733-5bb30b53aa14?ixlib=rb-4.0.3&auto=format&fit=crop&w=2074&q=80');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        display: flex;
        align-items: center;
        justify-content: center;
        position: fixed;
        top: 0;
        left: 0;
        margin: 0;
        padding: 0;
        z-index: 9999;
    }

    .hero-overlay {
        background: rgba(38, 36, 77, 0.2); /* converted #26244d to rgba with transparency */
        backdrop-filter: blur(2px);
        padding: 4rem 2rem;
        border-radius: 20px;
        text-align: center;
        max-width: 800px;
        margin: 0 2rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .hero-content {
        color: #26244d;
    }

    .hero-title {
        font-family: 'Montserrat', sans-serif;
        font-weight: 800;
        font-size: 5rem;
        margin-bottom: 1rem;
        background: linear-gradient(45deg, #ff6b6b, #4ecdc4, #45b7d1, #96ceb4);
        background-size: 300% 300%;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        -webkit-background-clip: text;
        animation: gradientShift 3s ease-in-out infinite;
        text-shadow: 0 0 30px rgba(255, 255, 255, 0.3);
        letter-spacing: 3px;
    }

    .hero-subtitle {
        font-family: 'Montserrat', sans-serif;
        font-size: 2rem;
        font-weight: 1000;
        margin-bottom: 2.5rem;
        color: #e0e0e0;
        letter-spacing: 1px;
    }

    .hero-description {
        font-family: 'Montserrat', sans-serif;
        font-size: 1.1rem;
        line-height: 1.6;
        margin-bottom: 2.5rem;
        color: #d0d0d0;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }

    .highlight-artists, .highlight-festivals, .highlight-style {
        background: linear-gradient(45deg, #ff6b6b, #4ecdc4, #45b7d1, #96ceb4);
        background-size: 300% 300%;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        -webkit-background-clip: text;
        animation: gradientShift 3s ease-in-out infinite;
    }

    .button-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2rem;
    }

    .dive-button {
        background: linear-gradient(135deg, #28a745, #20c997);
        border: none;
        color: white;
        padding: 16px 40px;
        font-size: 1.2rem;
        font-family: 'Montserrat', sans-serif;
        font-weight: 600;
        border-radius: 50px;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 8px 20px rgba(40, 167, 69, 0.4);
        letter-spacing: 1px;
        text-transform: uppercase;
    }

        .dive-button:hover {
            background: linear-gradient(135deg, #218838, #1eb396);
            transform: translateY(-3px);
            box-shadow: 0 12px 30px rgba(40, 167, 69, 0.6);
        }

        .dive-button:active {
            transform: translateY(-1px);
            box-shadow: 0 8px 20px rgba(40, 167, 69, 0.4);
        }

    .login-section {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 1rem;
        justify-content: center;
    }

    .login-text {
        font-family: 'Montserrat', sans-serif;
        font-size: 1rem;
        color: #b0b0b0;
        margin: 0;
    }

    .login-button {
        background: linear-gradient(135deg, #007bff, #0056b3);
        border: none;
        color: white;
        padding: 12px 30px;
        font-size: 1rem;
        font-family: 'Montserrat', sans-serif;
        font-weight: 500;
        border-radius: 30px;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(0, 123, 255, 0.3);
    }

        .login-button:hover {
            background: linear-gradient(135deg, #0056b3, #004085);
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(0, 123, 255, 0.4);
        }

        .login-button:active {
            transform: translateY(0);
            box-shadow: 0 3px 8px rgba(255, 255, 255, 0.2);
        }

    @@keyframes gradientShift {
        0%

    {
        background-position: 0% 50%;
    }

    50% {
        background-position: 100% 50%;
    }

    100% {
        background-position: 0% 50%;
    }

    }

    @@media (max-width: 768px) {
        .hero-title

    {
        font-size: 3rem;
    }

    .hero-subtitle {
        font-size: 1.5rem;
    }

    .hero-overlay {
        padding: 2rem 1rem;
        margin: 0 1rem;
    }

    .dive-button {
        padding: 14px 30px;
        font-size: 1rem;
    }

    .login-button {
        padding: 10px 25px;
        font-size: 0.9rem;
    }

    }
</style>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

@code {
    private void NavigateToSignin()
    {
        Navigation.NavigateTo("/signin");
    }

    private void NavigateToLogin()
    {
        Navigation.NavigateTo("/login");
    }
}