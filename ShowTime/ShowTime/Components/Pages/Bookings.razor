@page "/my-bookings"
@using ShowTime.BusinessLogic.Abstractions
@using ShowTime.BusinessLogic.Dtos
@inject IFestivalService FestivalService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<style>
    body {
        background-color: #26244d;
        margin: 0;
        padding: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .bookings-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
        color: white;
    }

    .page-header {
        text-align: center;
        margin-bottom: 2rem;
    }

        .page-header h3 {
            color: white;
            font-size: 2.5rem;
            font-weight: bold;
            margin: 0;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
        }

        .page-header .subtitle {
            color: #b8b5ff;
            font-size: 1.1rem;
            margin-top: 0.5rem;
        }

    .bookings-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 20px;
        margin-top: 2rem;
    }

    .booking-card {
        background: linear-gradient(135deg, #3d3b6b 0%, #4a4872 100%);
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.3);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: 1px solid #5a5894;
    }

        .booking-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 40px rgba(0,0,0,0.4);
        }

    .festival-name {
        font-size: 1.4rem;
        font-weight: bold;
        color: #fff;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .festival-icon {
        font-size: 1.5rem;
    }

    .booking-details {
        margin-bottom: 15px;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
        padding: 5px 0;
    }

    .detail-label {
        color: #b8b5ff;
        font-size: 0.9rem;
    }

    .detail-value {
        color: white;
        font-weight: 500;
    }

    .booking-status {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: bold;
        text-transform: uppercase;
    }

    .status-confirmed {
        background-color: #28a745;
        color: white;
    }

    .status-pending {
        background-color: #ffc107;
        color: #212529;
    }

    .status-cancelled {
        background-color: #dc3545;
        color: white;
    }

    .booking-actions {
        display: flex;
        gap: 10px;
        margin-top: 15px;
    }

    .btn {
        padding: 8px 16px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.9rem;
        font-weight: 500;
        transition: all 0.3s ease;
        text-decoration: none;
        text-align: center;
    }

    .btn-primary {
        background-color: #007bff;
        color: white;
    }

        .btn-primary:hover {
            background-color: #0056b3;
        }

    .btn-secondary {
        background-color: #6c757d;
        color: white;
    }

        .btn-secondary:hover {
            background-color: #545b62;
        }

    .btn-danger {
        background-color: #dc3545;
        color: white;
    }

        .btn-danger:hover {
            background-color: #c82333;
        }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #b8b5ff;
    }

        .empty-state .icon {
            font-size: 4rem;
            margin-bottom: 20px;
            opacity: 0.6;
        }

        .empty-state h4 {
            color: white;
            margin-bottom: 10px;
        }

        .empty-state p {
            margin-bottom: 20px;
            line-height: 1.6;
        }

    .filter-section {
        display: flex;
        gap: 15px;
        margin-bottom: 20px;
        flex-wrap: wrap;
        align-items: center;
    }

    .filter-select {
        padding: 8px 12px;
        border: 1px solid #5a5894;
        border-radius: 6px;
        background-color: #4a4872;
        color: white;
        font-size: 0.9rem;
    }

        .filter-select:focus {
            outline: none;
            border-color: #007bff;
        }

    .booking-date {
        font-size: 0.9rem;
        color: #b8b5ff;
        margin-bottom: 10px;
    }

    @@media (max-width: 768px) {
        .bookings-grid

    {
        grid-template-columns: 1fr;
    }

    .filter-section {
        flex-direction: column;
        align-items: stretch;
    }

    .page-header h3 {
        font-size: 2rem;
    }

    }
</style>

