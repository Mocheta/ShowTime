@page "/artists"
@using ShowTime.BusinessLogic.Abstractions
@using ShowTime.BusinessLogic.Dtos
@inject IArtistService ArtistService
@inject IFestivalService FestivalService
@inject NavigationManager Navigation
@rendermode InteractiveServer
@inject IJSRuntime JS

<style>
    body {
        background-color: #26244d;
    }

    .artists-container h2 {
        text-align: center;
        color: white;
        font-weight: bold;
        margin-bottom: 1.5rem;
    }

    .add-artist-btn-container {
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .btn-success {
        background-color: #28a745;
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-size: 1rem;
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

        .btn-success:hover {
            background-color: #218838;
        }

    .search-filter-container {
        max-width: 1200px;
        margin: 0 auto 2rem auto;
        padding: 1rem;
        background: #0d0d56;
        border-radius: 15px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    .search-bar {
        width: 100%;
        padding: 0.75rem;
        border: 2px solid #4a4a8a;
        border-radius: 10px;
        background: #26244d;
        color: white;
        font-size: 1rem;
        margin-bottom: 1rem;
    }

        .search-bar:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.3);
        }

        .search-bar::placeholder {
            color: #a0a0c0;
        }

    .filter-row {
        display: flex;
        gap: 1rem;
        align-items: center;
        flex-wrap: wrap;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .filter-label {
        color: white;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .filter-select {
        padding: 0.5rem;
        border: 2px solid #4a4a8a;
        border-radius: 8px;
        background: #26244d;
        color: white;
        font-size: 0.9rem;
        min-width: 150px;
    }

        .filter-select:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.3);
        }

        .filter-select option {
            background: #26244d;
            color: white;
        }

    .clear-filters-btn {
        background: #764ba2;
        color: white;
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        cursor: pointer;
        font-size: 0.9rem;
        transition: background-color 0.2s ease;
    }

        .clear-filters-btn:hover {
            background: #5a3a7a;
        }

    .results-info {
        color: #a0a0c0;
        text-align: center;
        margin-bottom: 1rem;
        font-size: 0.9rem;
    }

    .artists-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1rem;
        justify-items: center;
    }

    .artist-card {
        background: #0d0d56;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        width: 300px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .artist-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 16px rgba(0,0,0,0.3);
        }

    .artist-image-container {
        position: relative;
        width: 300px;
        height: 200px;
        overflow: hidden;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .artist-image {
        width: 300px;
        height: 200px;
        object-fit: cover;
        object-position: center;
        display: block;
    }

    .artist-name-overlay {
        position: absolute;
        bottom: 15px;
        right: 15px;
        color: white;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
        text-align: right;
    }

    .artist-name {
        font-weight: bold;
        font-size: 1.2rem;
        margin-bottom: 5px;
    }

    .artist-genre {
        font-size: 0.9rem;
        opacity: 0.9;
        font-weight: normal;
    }

    .artist-actions {
        padding: 15px;
        text-align: center;
    }

        .artist-actions button {
            transition: transform 0.2s ease, background-color 0.2s ease;
        }

            .artist-actions button:hover {
                transform: scale(1.05);
                filter: brightness(1.1);
            }

    .btn-primary {
        background-color: #007bff;
        color: white;
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        cursor: pointer;
        margin-right: 0.5rem;
    }

    .btn-danger {
        background-color: #dc3545;
        color: white;
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        cursor: pointer;
    }

    .no-results {
        text-align: center;
        color: #a0a0c0;
        font-size: 1.1rem;
        margin-top: 2rem;
    }

    .loading {
        text-align: center;
        color: #20c997;
        font-size: 1.2rem;
        margin-top: 3rem;
    }
</style>

<div class="artists-container">
    <h2>Artists</h2>

    <!-- Always show Add button -->
    <div class="add-artist-btn-container">
        <button class="btn-success" @onclick="@(() => Navigation.NavigateTo("/add-artist"))">
            Add New Artist
        </button>
    </div>

    @if (isLoading)
    {
        <div class="loading">
            🎪 Loading artists...
        </div>
    }
    else if (allArtists.Count > 0)
    {
        <div class="search-filter-container">
            <input type="text"
                   class="search-bar"
                   placeholder="Search artists by name or genre..."
                   @bind="searchTerm"
                   @oninput="OnSearchInput" />

            <div class="filter-row">
                <div class="filter-group">
                    <label class="filter-label">Filter by Genre:</label>
                    <select class="filter-select" @bind="selectedGenreFilter" @bind:after="ApplyFilters">
                        <option value="">All Genres</option>
                        @foreach (var genre in uniqueGenres)
                        {
                            <option value="@genre">@genre</option>
                        }
                    </select>
                </div>

                <div class="filter-group">
                    <label class="filter-label">Filter by Festival:</label>
                    <select class="filter-select" @bind="selectedFestivalFilter" @bind:after="ApplyFilters">
                        <option value="">All Festivals</option>
                        @foreach (var festival in allFestivals)
                        {
                            <option value="@festival.Id">@festival.Name</option>
                        }
                    </select>
                </div>

                <div class="filter-group">
                    <label class="filter-label">&nbsp;</label>
                    <button class="clear-filters-btn" @onclick="ClearFilters">Clear Filters</button>
                </div>
            </div>
        </div>

        <div class="results-info">
            Showing @filteredArtists.Count of @allArtists.Count artists
        </div>

        @if (filteredArtists.Count == 0)
        {
            <p class="no-results">No artists match your search criteria</p>
        }
        else
        {
            <div class="artists-grid">
                @foreach (var artist in filteredArtists)
                {
                    <div class="artist-card">
                        <div class="artist-image-container">
                            <img src="@artist.Image" alt="@artist.Name" class="artist-image" />
                            <div class="artist-name-overlay">
                                <div class="artist-name">@artist.Name</div>
                                <div class="artist-genre">@artist.Genre</div>
                            </div>
                        </div>
                        <div class="artist-actions">
                            <button class="btn-primary" @onclick="@(() => Navigation.NavigateTo($"/edit-artist/{artist.Id}"))">Edit</button>
                            <button class="btn-danger" @onclick="@(() => DeleteArtist(artist.Id))">Delete</button>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <p class="no-results">No artists registered. Click "Add New Artist" to get started!</p>
    }
</div>

@code {
    private IList<ArtistGetDto> allArtists = new List<ArtistGetDto>();
    private IList<ArtistGetDto> filteredArtists = new List<ArtistGetDto>();
    private IList<FestivalGetDto> allFestivals = new List<FestivalGetDto>();
    private string searchTerm = "";
    private string selectedGenreFilter = "";
    private string selectedFestivalFilter = "";
    private IList<string> uniqueGenres = new List<string>();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadArtists();
    }

    private async Task LoadArtists()
    {
        try
        {
            isLoading = true;
            allArtists = await ArtistService.GetAllArtistsAsync();
            allFestivals = await FestivalService.GetAllFestivalsAsync();
            filteredArtists = allArtists;

            // Get unique festivals that have artists
            var festivalsWithArtists = new List<FestivalGetDto>();
            foreach (var festival in allFestivals)
            {
                try
                {
                    var artists = await FestivalService.GetFestivalArtistsAsync(festival.Id);
                    if (artists != null && artists.Any())
                    {
                        festivalsWithArtists.Add(festival);
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading artists for festival {festival.Id}: {ex.Message}");
                }
            }
            allFestivals = festivalsWithArtists;

            // Populate unique genres for filter dropdown
            uniqueGenres = allArtists.Select(a => a.Genre).Distinct().OrderBy(g => g).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading artists: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        ApplyFilters();
    }

    private async Task ApplyFilters()
    {
        try
        {
            var artistsToShow = allArtists.AsEnumerable();

            // Search term filter
            if (!string.IsNullOrEmpty(searchTerm))
            {
                artistsToShow = artistsToShow.Where(artist =>
                    artist.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    artist.Genre.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
            }

            // Genre filter
            if (!string.IsNullOrEmpty(selectedGenreFilter))
            {
                artistsToShow = artistsToShow.Where(artist =>
                    artist.Genre.Equals(selectedGenreFilter, StringComparison.OrdinalIgnoreCase));
            }

            // Festival filter
            if (!string.IsNullOrEmpty(selectedFestivalFilter))
            {
                var festivalId = int.Parse(selectedFestivalFilter);
                var festivalArtists = await FestivalService.GetFestivalArtistsAsync(festivalId);
                var festivalArtistIds = festivalArtists?.Select(a => a.Id).ToHashSet() ?? new HashSet<int>();

                artistsToShow = artistsToShow.Where(artist => festivalArtistIds.Contains(artist.Id));
            }

            filteredArtists = artistsToShow.ToList();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error applying filters: {ex.Message}");
        }
    }

    private void ClearFilters()
    {
        searchTerm = "";
        selectedGenreFilter = "";
        selectedFestivalFilter = "";
        filteredArtists = allArtists;
        StateHasChanged();
    }

    private async Task DeleteArtist(int id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete this artist?");
        if (confirmed)
        {
            try
            {
                await ArtistService.DeleteArtistAsync(id);
                await LoadArtists();
                await ApplyFilters();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting artist: {ex.Message}");
            }
        }
    }
}